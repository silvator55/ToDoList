@model IEnumerable<ToDoList.Models.ToDo>

@{
    ViewData["Title"] = "TodoItem List";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchDate = ViewBag.SearchDate ?? "";
}


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container my-4">
    <div class="card border-0 shadow-lg p-4" style="border-radius: 20px; background: rgba(255, 255, 255, 0.95);">
        <h2 class="fw-bold mb-3">TodoItem List</h2>

        
        <div class="mb-3">
            <a asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2" style="border-radius: 8px;">
                Add New Task
            </a>
        </div>

        
        <form method="get" asp-action="Index" class="row g-2 mb-4 align-items-center">
            <div class="col-auto">
                <input type="date" name="searchDate" value="@searchDate" class="form-control" style="border-radius: 8px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary fw-semibold px-3" style="border-radius: 8px;">
                    Search
                </button>
            </div>
        </form>

       
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" style="background-color: #ffffff;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%;">Title</th>
                        <th style="width: 25%;">Description</th>
                        <th style="width: 20%;">Deadline</th>
                        <th style="width: 15%;">File</th>
                        <th style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                           
                            var timeRemaining = item.Deadline - DateTime.Now;

                            bool isUrgentOrExpired = timeRemaining.TotalHours <= 24;

                            string deadlineStyle = isUrgentOrExpired
                                ? "background-color: #fce8e6; color: #8a1f1d; font-weight: 600;"
                                : "color: #212529;";

                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td style="@deadlineStyle">
                                    @item.Deadline.ToString("yyyy-MM-dd HH:mm")
                                    @if (isUrgentOrExpired)
                                    {
                                        <span class="badge bg-danger ms-1" style="font-size: 0.7rem;">
                                            @(timeRemaining.TotalSeconds < 0 ? "Expired" : "Due Soon")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.FilePath))
                                    {
                                        <a asp-action="DownloadFile" asp-route-id="@item.Id" class="btn btn-success btn-sm px-3" style="background-color: #198754; border: none;">
                                            Download
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No File</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-dark fw-semibold px-2 me-1" style="background-color: #ffc107; border: none;">
                                        Edit
                                    </a>

                                    <button type="button" class="btn btn-danger btn-sm px-2" style="background-color: #dc3545; border: none;" onclick="confirmDelete(@item.Id, '@item.Title')">
                                        Delete
                                    </button>

                                    <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:none;">
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No tasks found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchDate="@searchDate">Previous</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchDate="@searchDate">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchDate="@searchDate">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<script>
    function confirmDelete(id, title) {
        Swal.fire({
            title: 'Are you sure?',
            text: `Do you really want to delete "${title}"? This cannot be undone.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById(`delete-form-${id}`).submit();
            }
        });
    }
</script>